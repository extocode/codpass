parameters:
    # Minimum level for NEW code. The baseline (phpstan-baseline.neon) holds the
    # remaining errors. The plan is to make it smaller over time. Each level from 0 to 5
    # adds ~150 errors. Level 6 adds +1372 (missing-type-hint PHPDoc churn). Thus, 5 is
    # the highest level that is realistic to adopt. When the baseline becomes smaller,
    # raise the level toward 9: 5 -> ... -> 9.
    level: 5

    paths:
        - lib/SP
        - app/modules/web
        - app/modules/api

    excludePaths:
        # Vendor dependencies
        - vendor/*
        # Test files (you can enable them later)
        - tests/*
        # Generated/cache files
        - app/cache/*
        - app/config/*
        - app/temp/*
        - app/backup/*

    # Scan only these directories for classes
    scanDirectories:
        - lib/SP
        - app/modules

    # Do not scan files
    scanFiles: []

    # PHP version to analyze against (matches composer.json)
    phpVersion: 80400

    # Parallel processing for faster analysis
    parallel:
        maximumNumberOfProcesses: 4

    # Report unmatched ignored errors
    reportUnmatchedIgnoredErrors: false

    # Treat phpdoc types as certain
    treatPhpDocTypesAsCertain: false

    # Bootstrap file, if necessary, for constants/autoloading
    # bootstrapFiles:
    #     - vendor/autoload.php

    # Ignore specific error patterns (add as needed during baseline generation)
    ignoreErrors:
        # Example patterns - uncomment and adjust as needed:
        # - '#Call to an undefined method#'
        # - '#Access to an undefined property#'
        # - '#Parameter \$\w+ of method .+ has invalid type#'

# Include the baseline after you generate it
includes:
    - phpstan-baseline.neon
