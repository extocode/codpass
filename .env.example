# codPass bootstrap environment overrides.
#
# The primary configuration is in app/config/config.xml (the web installer
# creates it). This .env overrides only a few early bootstrap flags. To use it,
# copy it to .env. A missing .env is not an error (safeLoad).

# Enable verbose debug output. Accepts true/false/1/0/on/off.
SYSPASS_DEBUG=false

# Later, this file can get more bootstrap vars.
