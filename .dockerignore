# Build context exclusions. These files are large, generated, or host-specific.
# (The source is bind-mounted at runtime. The build context needs only the
#  Dockerfile and the docker/ helpers.)
vendor/
node_modules/
.git/
public/dist/

# Local tooling / caches
.idea/
.vite/
.php-cs-fixer.cache
.phpunit.result.cache
tests/.phpunit.cache/
tests/_output/
tests/res/cache/
tests/tmp/
*.log
